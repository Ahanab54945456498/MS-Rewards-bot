name: Microsoft Rewards Automation Bot

on:
  schedule:
    # প্রতিদিন নির্দিষ্ট সময় পরপর অটো রান হওয়ার জন্য
    - cron: '0 0,6 * * *'
  workflow_dispatch: # ম্যানুয়ালি টেস্ট রান করার জন্য

jobs:
  build-and-run:
    runs-on: ubuntu-latest

    steps:
    - name: Check out repository
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install playwright
        playwright install chromium
        playwright install-deps

    - name: Run Rewards Bot
      env:
        MS_EMAIL: ${{ secrets.MS_EMAIL }}
        MS_PASSWORD: ${{ secrets.MS_PASSWORD }}
        COOKIES_JSON: ${{ secrets.COOKIES_JSON }}
      run: python bot.py
